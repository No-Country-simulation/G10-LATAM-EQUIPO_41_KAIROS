# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repo.

# Proveedor: template (sin red) | gemini | groq | cerebras | openrouter | auto (cadena)
LLM_PROVIDER=template
LLM_MODEL=gemini-3.8-flash
LLM_MODELOS_RESPALDO=gemini-3.5-flash,gemini-flash-latest
GEMINI_API_KEY=

#------------------------------------------------ API KEYS ------------------------------------------------
# Varias claves de Gemini separadas por coma: si una agota su cuota diaria, rota automáticamente
#GEMINI_API_KEYS=clave-1,clave-2,clave-3

# --- Control de tasa (RPM/TPM) y optimización de Gemini ---
#GEMINI_RPM_DELAY=1.5            # Pausa prudente en segundos entre llamadas para no saturar RPM/TPM
#GEMINI_PREFERIR_FLASH=true      # Si es true, optimiza variantes 'Pro' a 'Flash' para mayor cuota
#GEMINI_MAX_REINTENTOS=5         # Reintentos con backoff exponencial y jitter ante 503 / 429 RPM
#GEMINI_DELAY_BASE=2.0           # Delay inicial de reintento en segundos (se duplica con jitter)


# Con LLM_PROVIDER=auto se prueban estas APIs en orden hasta que una responda.
# Cada una tiene cuota propia y plan gratuito, así que rotar multiplica la capacidad.
LLM_CADENA=gemini,groq,cerebras,openrouter
# Modelos por proveedor (opcional; si no, se usan los gratuitos por defecto de cada API)
#LLM_MODELOS_GROQ=openai/gpt-oss-120b,openai/gpt-oss-20b
#LLM_MODELOS_CEREBRAS=gpt-oss-120b,qwen-3.8-27b
#LLM_MODELOS_OPENROUTER=openrouter/free
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

EMBEDDINGS_PROVIDER=local

CHUNK_SIZE=900
CHUNK_OVERLAP=150

FIDELITY_MIN_GENERAL=0.85
FIDELITY_MIN_SALUD=0.90
MAX_REINTENTOS_CRITICO=2

OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=
OCI_BUCKET=nuevamente-contenidos-educativos

FALLBACK_DIR=data/fallback

# Video del Guion de Clase: auto usa la voz del sistema (say / espeak-ng); off, sin narración
VIDEO_TTS=auto
VIDEOS_DIR=data/videos
MAX_UPLOAD_MB=10
