# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repo.

# template: generador extractivo sin red | gemini: API de Gemini (requiere GEMINI_API_KEY)
LLM_PROVIDER=template
LLM_MODEL=gemini-3.8-flash
LLM_MODELOS_RESPALDO=gemini-3.5-flash,gemini-flash-latest
GEMINI_API_KEY=
EMBEDDINGS_PROVIDER=local

CHUNK_SIZE=900
CHUNK_OVERLAP=150

FIDELITY_MIN_GENERAL=0.85
FIDELITY_MIN_SALUD=0.90
MAX_REINTENTOS_CRITICO=2

OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=
OCI_BUCKET=nuevamente-contenidos-educativos

FALLBACK_DIR=data/fallback

# Video del Guion de Clase: auto usa la voz del sistema (say / espeak-ng); off, sin narración
VIDEO_TTS=auto
VIDEOS_DIR=data/videos
MAX_UPLOAD_MB=10
