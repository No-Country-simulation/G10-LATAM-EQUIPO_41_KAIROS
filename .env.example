# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repo.

# Proveedor: template (sin red) | gemini | groq | cerebras | openrouter | cohere | openai | auto (cadena)

LLM_PROVIDER=template
LLM_MODEL=gemini-3.8-flash-lite
LLM_MODELOS_RESPALDO=gemini-3.5-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-flash-latest,gemini-3.5-flash-lite,gemini-flash-lite-latest
# true: si Gemini no está disponible, se genera con el proveedor local (template)
LLM_RESPALDO_LOCAL=true
# Espera máxima de cada llamada a las voces de Gemini (podcast) y minutos que se omite
# un servicio tras un fallo, para no volver a esperarlo.
LLM_TIMEOUT_S=40
LLM_PAUSA_TRAS_FALLO_MIN=10
GEMINI_API_KEY=
# Varias llaves de Gemini separadas por comas: se rotan cuando una se queda sin cuota
# (si está vacío se usa GEMINI_API_KEY).
GEMINI_API_KEYS=
# true: probar primero los modelos Flash, más rápidos y con más cuota gratuita
GEMINI_PREFERIR_FLASH=true
GEMINI_MAX_REINTENTOS=2
# Segundos de espera entre llamadas (límite de solicitudes por minuto) y base del reintento
GEMINI_RPM_DELAY=0.5
GEMINI_DELAY_BASE=1.0
GEMINI_TIMEOUT=90

# Cadena de proveedores para LLM_PROVIDER=auto, en orden de preferencia
LLM_CADENA=gemini,groq,cerebras,openrouter
# Groq (gratuito): https://console.groq.com/keys
GROQ_API_KEY=
# Cerebras (gratuito): https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# OpenRouter (modelos gratuitos): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modelos de cada proveedor, separados por comas. Vacío = los modelos gratuitos por defecto.
LLM_MODELOS_GROQ=
LLM_MODELOS_CEREBRAS=
LLM_MODELOS_OPENROUTER=
LLM_MODELOS_COHERE=
LLM_MODELOS_OPENAI=
# Claude (pip install -e ".[claude]"): https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Cohere (plan de prueba gratuito, con LLM_PROVIDER=cohere o en LLM_CADENA): https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# OpenAI (de pago, sin plan gratuito; con LLM_PROVIDER=openai o en LLM_CADENA): https://platform.openai.com/api-keys
OPENAI_API_KEY=
CLAUDE_MODEL=claude-opus-5
# auto: embeddings semánticos de Gemini (gemini-embedding-001) si hay GEMINI_API_KEY,
# con TF-IDF local de respaldo si Gemini falla | gemini | local (solo TF-IDF, sin red)
EMBEDDINGS_PROVIDER=auto
EMBEDDINGS_MODELO=gemini-embedding-001
EMBEDDINGS_DIMENSIONES=768
# Vector store: local (en memoria) | chroma (ChromaDB persistente en VECTORSTORE_DIR/chroma; pip install chromadb)
VECTOR_STORE=local
VECTORSTORE_DIR=data/vectorstore
# Juez de IA para la fidelidad y la coherencia didáctica: auto (con un LLM real) | off (solo TF-IDF)
JUEZ_IA=auto
# OCR de PDF escaneados con Gemini: auto | off
OCR=auto

CHUNK_SIZE=900
CHUNK_OVERLAP=150

FIDELITY_MIN_GENERAL=0.85
FIDELITY_MIN_SALUD=0.90
MAX_REINTENTOS_CRITICO=2

# --- Enrutado por salud (ver src/nuevamente/llm/salud.py) --------------------
# LLM_CADENA es el orden *deseado*. El router lo reordena en cada petición según cómo se estén
# portando los proveedores de verdad: aparta los caídos y pone delante el más rápido medido.
# Sin esto, la cadena se recorre siempre desde el principio y un proveedor lento se paga
# entero (con sus reintentos y su timeout) en cada request.
LLM_SALUD_ACTIVADA=true
# Fallos *consecutivos* que abren el circuito de un proveedor. Con 2, un 503 suelto no apaga a
# nadie; una racha, sí.
LLM_SALUD_UMBRAL_FALLOS=2
# Pausa antes de volver a probar un proveedor caído; se dobla en cada apertura hasta el tope.
LLM_SALUD_COOLDOWN_S=45
LLM_SALUD_COOLDOWN_MAX_S=300
# Peso de la última latencia en la media móvil (0-1). Alto = reacciona rápido a uno que se
# degrada; bajo = olvida el historial más despacio.
LLM_SALUD_ALFA=0.3
# Latencias medidas a mano en esta máquina, solo para arrancar en frío (la primera petición no
# debe esperar a descubrir cuál es el rápido). A partir de la segunda manda lo observado.
# Formato proveedor:segundos, con los nombres de LLM_CADENA en minusculas.
LLM_SALUD_LATENCIA=gemini:4.0,groq:1.2,openrouter:8.0

# Carrera: pedir el prompt a los N proveedores más sanos a la vez y quedarse con el primero que
# conteste. Es lo que hace que nunca se espere a un proveedor lento, aunque esté sano pero
# lento. Cuesta el doble de llamadas (la perdedora se desperdicia), por eso va apagada por defecto.
LLM_CARRERA=false
LLM_CARRERA_CUANTOS=2
# Espera antes de lanzar al segundo. 0 = salen los dos juntos (lo más rápido, lo que más cuota
# gasta). 1.5 = el segundo solo sale si el primero no contestó, que es donde el gasto compensa.
LLM_CARRERA_ESPERA_S=0

OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=
OCI_BUCKET=nuevamente-contenidos-educativos
# false solo si un proxy o antivirus intercepta HTTPS (desactiva la verificación TLS únicamente para OCI)
OCI_SSL_VERIFY=true

FALLBACK_DIR=data/fallback

# Video del Guion de Clase: auto usa la voz del sistema (say / espeak-ng); off, sin narración
VIDEO_TTS=auto
# Voces del video: gemini (Gemini, luego OpenAI, luego sistema) | openai (OpenAI, luego sistema) | sistema
VIDEO_VOCES=gemini
VIDEO_VOZ_FEMENINA=Sulafat
# otras voces masculinas de Gemini: Orus, Iapetus, Algieba
VIDEO_VOZ_MASCULINA=Charon
# Voces naturales de OpenAI TTS (respaldo de Gemini, o primeras con VIDEO_VOCES=openai).
# Requieren OPENAI_API_KEY; de pago, unos 0,015 USD por minuto. Masculinas: ash, onyx, echo,
# ballad, verse · femeninas: coral, nova, shimmer, sage.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
VIDEO_VOZ_OPENAI_MASCULINA=ash
VIDEO_VOZ_OPENAI_FEMENINA=coral
# Voces neuronales de Microsoft Edge (gratis, sin API key): respaldo cuando Gemini y OpenAI
# no responden y el servidor no tiene voz del sistema (Render). auto | off
EDGE_TTS=auto
VIDEO_VOZ_EDGE_FEMENINA=es-MX-DaliaNeural
VIDEO_VOZ_EDGE_MASCULINA=es-MX-JorgeNeural
# modelos TTS a probar si PODCAST_TTS_MODEL se queda sin cuota (10 solicitudes/día cada uno)
TTS_MODELOS_RESPALDO=gemini-3.8-flash-tts,gemini-2.5-flash-preview-tts,gemini-3.8-flash-lite-tts
VIDEOS_DIR=data/videos
# Hilos de ffmpeg para el video (1 en servidores con poca CPU, como Render gratuito)
VIDEO_HILOS=1

# Voces del Podcast: gemini (voces naturales, usa GEMINI_API_KEY) | sistema (voces del SO)
PODCAST_VOCES=gemini
PODCAST_TTS_MODEL=gemini-3.1-flash-tts-preview
PODCAST_VOZ_ANA=Sulafat
PODCAST_VOZ_LEO=Charon
MAX_UPLOAD_MB=10

# Estadísticas de uso y calificaciones (eventos en eventos.jsonl)
ESTADISTICAS_DIR=data/estadisticas

# Caché de contenido generado (post-Crítico): ahorra tokens del LLM. Solo guarda contenido
# ya aprobado por el Crítico. Empieza desactivado por seguridad.
CACHE_CONTENIDO_ACTIVADO=false
# Scoped: true => solo para (formato="Resumen Ejecutivo" AND nicho="Salud")
CACHE_CONTENIDO_SCOPED=true
CACHE_CONTENIDO_MAX_ENTRIES=32
CACHE_CONTENIDO_TTL_S=3600
CACHE_INCLUIR_PROMPTS_SHA=true
CACHE_INCLUIR_SCHEMA_SHA=true
