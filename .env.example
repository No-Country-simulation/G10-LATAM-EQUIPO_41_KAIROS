# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repo.

# Proveedor: template (sin red) | gemini | groq | cerebras | openrouter | auto (cadena)

LLM_PROVIDER=template
LLM_MODEL=gemini-3.8-flash-lite
LLM_MODELOS_RESPALDO=gemini-3.5-flash,gemini-flash-latest
# true: si Gemini no está disponible, se genera con el proveedor local (template)
LLM_RESPALDO_LOCAL=true
# Espera máxima de cada llamada a las voces de Gemini (podcast) y minutos que se omite
# un servicio tras un fallo, para no volver a esperarlo.
LLM_TIMEOUT_S=40
LLM_PAUSA_TRAS_FALLO_MIN=10
GEMINI_API_KEY=
# Claude (pip install -e ".[claude]"): https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
EMBEDDINGS_PROVIDER=local

CHUNK_SIZE=900
CHUNK_OVERLAP=150

FIDELITY_MIN_GENERAL=0.85
FIDELITY_MIN_SALUD=0.90
MAX_REINTENTOS_CRITICO=2

# --- Enrutado por salud (ver src/nuevamente/llm/salud.py) --------------------
# LLM_CADENA es el orden *deseado*. El router lo reordena en cada petición según cómo se estén
# portando los proveedores de verdad: aparta los caídos y pone delante el más rápido medido.
# Sin esto, la cadena se recorre siempre desde el principio y un proveedor lento se paga
# entero (con sus reintentos y su timeout) en cada request.
LLM_SALUD_ACTIVADA=true
# Fallos *consecutivos* que abren el circuito de un proveedor. Con 2, un 503 suelto no apaga a
# nadie; una racha, sí.
LLM_SALUD_UMBRAL_FALLOS=2
# Pausa antes de volver a probar un proveedor caído; se dobla en cada apertura hasta el tope.
LLM_SALUD_COOLDOWN_S=45
LLM_SALUD_COOLDOWN_MAX_S=300
# Peso de la última latencia en la media móvil (0-1). Alto = reacciona rápido a uno que se
# degrada; bajo = olvida el historial más despacio.
LLM_SALUD_ALFA=0.3
# Latencias medidas a mano en esta máquina, solo para arrancar en frío (la primera petición no
# debe esperar a descubrir cuál es el rápido). A partir de la segunda manda lo observado.
# Formato proveedor:segundos, con los nombres de LLM_CADENA en minusculas.
LLM_SALUD_LATENCIA=gemini:4.0,groq:1.2,openrouter:8.0

# Carrera: pedir el prompt a los N proveedores más sanos a la vez y quedarse con el primero que
# conteste. Es lo que hace que nunca se espere a un proveedor lento, aunque esté sano pero
# lento. Cuesta el doble de llamadas (la perdedora se desperdicia), por eso va apagada por defecto.
LLM_CARRERA=false
LLM_CARRERA_CUANTOS=2
# Espera antes de lanzar al segundo. 0 = salen los dos juntos (lo más rápido, lo que más cuota
# gasta). 1.5 = el segundo solo sale si el primero no contestó, que es donde el gasto compensa.
LLM_CARRERA_ESPERA_S=0

OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=
OCI_BUCKET=nuevamente-contenidos-educativos

FALLBACK_DIR=data/fallback

# Video del Guion de Clase: auto usa la voz del sistema (say / espeak-ng); off, sin narración
VIDEO_TTS=auto
VIDEOS_DIR=data/videos

# Voces del Podcast: gemini (voces naturales, usa GEMINI_API_KEY) | sistema (voces del SO)
PODCAST_VOCES=gemini
PODCAST_TTS_MODEL=gemini-3.1-flash-tts-preview
PODCAST_VOZ_ANA=Sulafat
PODCAST_VOZ_LEO=Charon
MAX_UPLOAD_MB=10
